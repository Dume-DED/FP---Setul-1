// Se dau doua variabile numerice a si b ale carori valori sunt date de intrare. Se cere sa se inverseze valorile lor. 
string aTxt = Console.ReadLine();
string bTxt = Console.ReadLine();
int a = int.Parse(aTxt);
int b = int.Parse(bTxt);
int temp;
temp = a;
a = b;
b = temp;
Console.WriteLine($"a = {a}, b = {b}");
