// Detreminati daca trei numere pozitive a, b si c pot fi lungimile laturilor unui triunghi. 
string aTxt = Console.ReadLine();
string bTxt = Console.ReadLine();
string cTxt = Console.ReadLine();
int a = int.Parse(aTxt);
int b = int.Parse(bTxt);
int c = int.Parse(cTxt);
if(a != 0 && b != 0 && c != 0)
{
    if (a + b > c && a + c > b && b + c > a)
    {
        Console.WriteLine("Da");
    }
    else
    {
        Console.WriteLine("Nu");
    }

}
else
{
    Console.WriteLine("Nu");
}
