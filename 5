// Extrageti si afisati a k-a cifra de la sfarsitul unui numar. Cifrele se numara de la dreapta la stanga. 
string nrTxt = Console.ReadLine();
int nr = int.Parse(nrTxt);
int i = 1;
string kTxt = Console.ReadLine();
int k = int.Parse(kTxt);int uc;
while (nr > 0)
{
    if ( i == k)
    {
        uc = nr % 10;
        Console.WriteLine(uc);
    }
    nr = nr / 10;
    i++;
}
